{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticPrefixFixDepsChoreOthers"
  ],
  "enabledManagers": [
    "flux",
    "helm-values",
    "kubernetes",
    "pep621",
    "github-actions"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^infrastructure\\/.+\\.ya?ml$/",
      "/^clusters\\/sisyphus\\/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^infrastructure\\/.+\\.ya?ml$/",
      "/^clusters\\/sisyphus\\/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/*.sops.yaml",
    "clusters/sisyphus/flux-system/gotk-components.yaml",
    "infrastructure/portfolio-staging/deployment.yaml",
    "infrastructure/portfolio-staging/image-automation.yaml",
    "infrastructure/malg/api-deployment.yaml",
    "infrastructure/malg/worker-deployment.yaml",
    "infrastructure/malg/frontend-deployment.yaml",
    "infrastructure/malg/image-automation.yaml",
    "infrastructure/malg/crm-schema/job.yaml",
    "infrastructure/malg/migration-job.yaml",
    "infrastructure/twenty/server-deployment.yaml",
    "infrastructure/twenty/worker-deployment.yaml",
    "infrastructure/twenty/image-automation.yaml"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "labels": ["dependencies", "infrastructure"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "major"]
    },
    {
      "matchPackageNames": ["twentycrm/twenty"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "labels": ["dependencies", "container"]
    },
    {
      "matchFileNames": [
        "infrastructure/cloudflare-tunnel/deployment.yaml",
        "infrastructure/litellm/headroom-deployment.yaml",
        "infrastructure/malg/searxng-deployment.yaml",
        "infrastructure/malg/lightpanda-deployment.yaml",
        "infrastructure/kite/helmrelease.yaml"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "automergeStrategy": "squash",
      "labels": ["dependencies", "app-auto-update"]
    },
    {
      "matchFileNames": [
        "infrastructure/litellm/helmrelease.yaml",
        "infrastructure/litellm/litellm-ocirepository.yaml"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "LiteLLM release",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "automergeStrategy": "squash",
      "labels": ["dependencies", "app-auto-update"]
    }
  ]
}
